# HTTP
HTTP_PORT=8080

# TCP Socket (원본 서버 포트 22131)
TCP_PORT=22131
TCP_HOST=0.0.0.0

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=findit
DB_PASSWORD=findit_dev
DB_NAME=findit_game

# Cloud Run + Cloud SQL 환경에서는 대신:
# DB_SOCKET=/cloudsql/PROJECT:asia-northeast3:findit-db

# 환경
NODE_ENV=development
LOG_LEVEL=dev
