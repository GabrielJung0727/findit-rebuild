<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 기본 권한 (모든 앱 공통) -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE"/>
    <uses-permission android:name="android.permission.VIBRATE"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>

    <!-- 결제 (Play Store / Samsung) -->
    <uses-permission android:name="com.android.vending.BILLING"/>
    <uses-permission android:name="com.sec.android.iap.permission.BILLING"/>

    <!-- 외부 저장소 — Android 10+ 부터는 Scoped Storage 자동, 11+ 무관.
         원본 코드가 사용 → maxSdkVersion 28 로 한정해 Play Protect 경고 회피. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"  android:maxSdkVersion="28"/>
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28"/>

    <!-- ─────────────────────────────────────────────────────────────
         제거된 권한 (Google Play Protect 차단 트리거):
         · RECEIVE_SMS / SmsReceiver  → KT/SKT SMS 결제 (서비스 종료)
         · READ_PHONE_STATE           → IMEI/번호 (현대 앱은 ANDROID_ID 사용)
         · GET_TASKS                  → API 21 부터 deprecated, 보안 위험
         ───────────────────────────────────────────────────────────── -->

    <application android:allowBackup="true" android:icon="@drawable/icon" android:label="@string/app_name" android:name="com.findit.battle.FindItApplication" android:networkSecurityConfig="@xml/network_security_config" android:usesCleartextTraffic="false">
        <activity android:configChanges="orientation" android:exported="true" android:label="@string/app_name" android:launchMode="singleTop" android:name="com.findit.battle.GameActivity" android:screenOrientation="landscape" android:theme="@android:style/Theme.NoTitleBar.Fullscreen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <activity android:name="com.findit.battle.JoinActivity" android:screenOrientation="landscape" android:theme="@style/CustomDialog"/>
        <activity android:configChanges="keyboardHidden|orientation" android:name="com.findit.battle.InventoryActivity_Google" android:screenOrientation="landscape" android:theme="@style/CustomDialog" android:windowSoftInputMode="adjustNothing"/>
        <activity android:configChanges="keyboardHidden|orientation" android:name="com.findit.battle.InventoryActivity_Olleh" android:screenOrientation="landscape" android:theme="@style/CustomDialog"/>
        <activity android:configChanges="keyboardHidden|orientation" android:name="com.findit.battle.InventoryActivity_T" android:screenOrientation="landscape" android:theme="@style/CustomDialog"/>
        <activity android:name="com.findit.battle.SetupActivity" android:screenOrientation="landscape" android:theme="@style/CustomDialog"/>
        <activity android:name="com.findit.battle.NoticeActivity" android:noHistory="true" android:screenOrientation="landscape" android:theme="@style/CustomDialog"/>
        <activity android:name="com.findit.battle.RankActivity" android:noHistory="true" android:screenOrientation="landscape" android:theme="@style/CustomDialog"/>
        <service android:name="com.kt.olleh.inapp.TimerService"/>
        <!-- SmsReceiver 제거 — RECEIVE_SMS 권한 없으므로 동작 불가능, Play Protect 트리거 -->
    </application>
</manifest>
