    </RelativeLayout>
    <ImageView android:id="@id/RingTextImageView" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <RelativeLayout android:id="@id/RingIconSlotLayout" android:layout_width="wrap_content" android:layout_height="wrap_content">
