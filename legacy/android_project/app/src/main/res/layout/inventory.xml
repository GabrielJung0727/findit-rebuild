    <LinearLayout android:gravity="center" android:layout_width="wrap_content" android:layout_height="wrap_content">
        <ImageView android:id="@id/AttackImageView" android:background="@drawable/attack" android:layout_width="18.0dp" android:layout_height="18.0dp" android:layout_marginRight="2.0dp" />
