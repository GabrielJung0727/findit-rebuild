# macOS
.DS_Store
.env

# IntelliJ / Android Studio
.idea/
*.iml
/apk_analysis.iml

# Gradle
legacy/android_project/.gradle/
legacy/android_project/build/
legacy/android_project/app/build/
legacy/android_project/captures/
legacy/android_project/.cxx/

# Android Studio per-machine config (SDK path, signing keys)
legacy/android_project/local.properties

# Compiled / generated
legacy/android_project/**/*.class
out/

# Logs
*.log

# 서명 키스토어 — 절대 커밋 금지
*.keystore
*.jks

# Flutter / Dart 빌드 산출물
legacy/client_flutter/build/
legacy/client_flutter/.dart_tool/
app/build/
app/.dart_tool/
app/ios/
app/android/
# macos·web 도 같은 이유로 넣지 않는다. P0 의 타깃은 iOS·Android 이고
# (스펙 §2), 플랫폼 폴더는 Plan 6 의 빌드 파이프라인이 서명·번들 ID 설정과
# 함께 넣는다. flutter create 가 만들어 두더라도 커밋하지 않는다.
app/macos/
app/web/
app/linux/
app/windows/
app/.flutter-plugins-dependencies

# Node
node_modules/

# 에셋 파이프라인 산출물 (tools 로 재생성 가능)
content/images/
app/assets/legacy/
app/assets/audio/

# TypeScript 증분 빌드 정보
*.tsbuildinfo

# TypeScript composite 빌드 산출물 (tsc -b 가 각 워크스페이스에 생성)
tools/dist/
packages/*/dist/
server/dist/
