    <ImageView android:id="@id/PotionTextImageView" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <RelativeLayout android:id="@id/PotionIconSlotLayout" android:layout_width="wrap_content" android:layout_height="wrap_content">
        <ImageView android:id="@id/PotionIconImageView" android:layout_width="match_parent" android:layout_height="match_parent" />
        <TextView android:id="@id/PotionIconTextView" android:layout_width="match_parent" android:layout_height="match_parent" />
