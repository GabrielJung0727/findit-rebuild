<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  04-26.md §11 — APNs 푸시 환경 선언.

  값:
    development : Xcode 디버그 빌드 / TestFlight (sandbox APNs)
    production  : App Store 배포 빌드 (production APNs)

  Xcode 가 빌드 환경에 따라 자동 처리하도록 development 로 두는 것이 일반적.
  EAS / Codemagic 같은 CI 에서 release 빌드 시 production 으로 swap 가능.

  Xcode 에서 Signing & Capabilities → Push Notifications 추가 시 이 파일이 자동 생성됨.
  여기서는 수동 작성 — 실 배포 전에 Xcode 에서 Capability 활성 여부 확인 필요.
-->
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
