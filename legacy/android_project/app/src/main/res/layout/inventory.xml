        <Button android:textSize="10.0sp" android:textColor="#a5876d" android:id="@id/SkillLearnButton" android:tag="not" android:background="@drawable/dlg_btn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/learn" />
    </RelativeLayout>
    <ImageView android:id="@id/MoveIconImageView" android:visibility="invisible" android:layout_width="wrap_content" android:layout_height="wrap_content" />
