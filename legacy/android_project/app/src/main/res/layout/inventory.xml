            </LinearLayout>
        </ScrollView>
    </RelativeLayout>
    <RelativeLayout android:orientation="vertical" android:id="@id/ShopLayout" android:visibility="invisible" android:layout_width="match_parent" android:layout_height="match_parent">
        <LinearLayout android:gravity="center_vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
            <ImageView android:gravity="right|center" android:id="@id/ShopLevelImageView" android:background="@drawable/level" android:layout_width="18.0dp" android:layout_height="16.0dp" android:layout_marginRight="4.0dp" />
