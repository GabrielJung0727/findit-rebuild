            <Button android:id="@id/ShopSlotPreButton" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <LinearLayout android:gravity="center" android:layout_width="wrap_content" android:layout_height="wrap_content">
                <HorizontalScrollView android:id="@id/ShopSlotHorizontalScrollView" android:scrollbars="none" android:layout_width="wrap_content" android:layout_height="wrap_content">
                    <LinearLayout android:orientation="horizontal" android:id="@id/ShopItemSlotsLayout" android:layout_width="match_parent" android:layout_height="match_parent" />
                </HorizontalScrollView>
            </LinearLayout>
            <Button android:id="@id/ShopSlotNextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <ImageView android:id="@id/ShopLine1ImageView" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <ScrollView android:layout_width="wrap_content" android:layout_height="match_parent">
                <LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent">
                    <TextView android:textColor="#54443b" android:id="@id/ShopExplainTextView" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                </LinearLayout>
            </ScrollView>
            <Button android:textSize="10.0sp" android:textColor="#a5876d" android:id="@id/ShopBuyButton" android:tag="not" android:background="@drawable/dlg_btn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/buy" />
