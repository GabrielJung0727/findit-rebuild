    <Button android:id="@id/ShopTabButton" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <Button android:id="@id/SkillTabButton" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <ImageView android:id="@id/WindowsBgImageView" android:tag="not" android:background="@drawable/popup_0" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <RelativeLayout android:id="@id/ItemLayout" android:layout_width="wrap_content" android:layout_height="wrap_content">
        <LinearLayout android:gravity="center_vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
