        <Button android:id="@id/SlotPreButton" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <LinearLayout android:gravity="center" android:layout_width="wrap_content" android:layout_height="wrap_content">
            <HorizontalScrollView android:gravity="center" android:id="@id/SlotHorizontalScrollView" android:scrollbars="none" android:layout_width="wrap_content" android:layout_height="wrap_content">
                <LinearLayout android:orientation="horizontal" android:id="@id/SlotsLayout" android:layout_width="match_parent" android:layout_height="match_parent" />
            </HorizontalScrollView>
        </LinearLayout>
        <Button android:id="@id/SlotNextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" />
