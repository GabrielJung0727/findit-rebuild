<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="#e9e0c2"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="133">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="30"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="265">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="21"/>
            <ImageView
                android:id="@+id/TitleImageView"
                android:background="@drawable/join_title"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="100"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="12"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="985"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="470">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="30"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="482">
            <EditText
                android:textSize="13sp"
                android:id="@+id/EmailEditText"
                android:background="@drawable/inputbox_0"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/email"
                android:layout_weight="1"
                android:inputType="textEmailAddress"/>
            <EditText
                android:textSize="13sp"
                android:id="@+id/PasswordEditText"
                android:background="@drawable/inputbox_0"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/password"
                android:layout_weight="1"
                android:inputType="textPassword"/>
            <EditText
                android:textSize="13sp"
                android:id="@+id/IdentifyPasswordEditText"
                android:background="@drawable/inputbox_0"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/identify_password"
                android:layout_weight="1"
                android:inputType="textPassword"/>
            <EditText
                android:textSize="13sp"
                android:id="@+id/NicknameEditText"
                android:background="@drawable/inputbox_0"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/nickname"
                android:layout_weight="1"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="25"/>
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/join_charac_bg"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="720">
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="10dp"
                android:layout_weight="1">
                <ImageView
                    android:id="@+id/SelectTextImageView"
                    android:background="@drawable/join_charac_text"
                    android:layout_width="155dp"
                    android:layout_height="23dp"/>
                <ImageView
                    android:id="@+id/ArrowImageView"
                    android:background="@drawable/join_charac_arrow"
                    android:layout_width="30dp"
                    android:layout_height="22dp"/>
            </LinearLayout>
            <HorizontalScrollView
                android:id="@+id/CharactersHorizontalScrollView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginBottom="10dp"
                android:layout_weight="2">
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/CharactersLayout"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginBottom="10dp"/>
            </HorizontalScrollView>
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="23"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="197">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="30"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="283">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="20"/>
            <LinearLayout
                android:id="@+id/AutoLoginLayout"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="177">
                <ImageView
                    android:id="@+id/AutoLoginCheckImageView"
                    android:background="@drawable/login_check_on"
                    android:layout_width="28dp"
                    android:layout_height="28dp"/>
                <ImageView
                    android:id="@+id/AutoLoginTextImageView"
                    android:background="@drawable/login_text_autologin"
                    android:layout_width="90dp"
                    android:layout_height="25dp"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="255">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="21"/>
            <Button
                android:id="@+id/JoinButton"
                android:background="@drawable/join_btn_join"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="42"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="23"/>
    </LinearLayout>
</LinearLayout>
