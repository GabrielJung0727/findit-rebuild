    <ImageView android:id="@id/BerryTextImageView" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <RelativeLayout android:id="@id/BerryIconSlotLayout" android:layout_width="wrap_content" android:layout_height="wrap_content">
        <ImageView android:id="@id/BerryIconImageView" android:layout_width="match_parent" android:layout_height="match_parent" />
        <TextView android:id="@id/BerryIconTextView" android:layout_width="match_parent" android:layout_height="match_parent" />
